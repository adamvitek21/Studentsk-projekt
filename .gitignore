cat > .gitignore << 'EOF'
# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/

# Node
node_modules/
npm-debug.log*
package-lock.json

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Secrets
.env
*.secret
*.key

# Logs & temp
*.log
logs/
*.swp
*~

# Test
.coverage
.pytest_cache/
htmlcov/

# Build
dist/
build/

# Local feeds
*.pb
/tmp/
EOF