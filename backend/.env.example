# Golemio API klíč - získej na https://api.golemio.cz/api-keys
# Zaregistruj se a vytvoř API klíč pro přístup k GTFS-RT datům
GOLEMIO_API_KEY=your-api-key-here

# GTFS-RT URL pro Pražskou integrovanou dopravu
# Vehicle Positions (pozice vozidel)
GTFS_RT_URL=https://api.golemio.cz/v2/vehiclepositions/gtfsrt/

# Alternativní endpoints:
# Trip Updates (aktualizace jízd, zpoždění)
# GTFS_RT_URL=https://api.golemio.cz/v2/gtfs/rt/trip_updates/

# Interval dotazování v sekundách (doporučeno 10-30s)
GTFS_POLL_INTERVAL=15

# Headers pro API (JSON formát)
# GTFS_RT_HEADERS={"X-Access-Token":"your-api-key-here"}
